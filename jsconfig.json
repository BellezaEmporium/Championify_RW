{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vitest/globals", "node", "jsdom"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/*"],
      "~/*": ["src/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "vitest.config.js"],
  "exclude": ["node_modules", "dist", "coverage", "tmp"]
}
