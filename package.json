{
  "name": "championify",
  "version": "3.0.0",
  "type": "module",
  "description": "Downloads all the recent builds from websites like Champion.gg and imports them in to League of Legends.",
  "main": "dist/main/electron.js",
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:clean": "node scripts/clean-test-env.js",
    "build": "electron-vite build",
    "build:osx": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "dev": "electron-vite dev",
    "debug": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron . --inspect-brk=5174\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "package:asar": "asar pack dist app.asar",
    "postinstall": "node scripts/postinstall.js",
    "preview": "electron-vite preview",
    "release": "yarn build:win && yarn build:osx",
    "release:win": "electron-builder --win --publish always",
    "release:osx": "electron-builder --mac --publish always"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BellezaEmporium/Championify-RW.git"
  },
  "author": "Dustin Blackman / Ismaël Moret",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@eslint/js": "^9.33.0",
    "@lokalise/node-api": "^15.2.1",
    "@stylistic/eslint-plugin": "^5.2.3",
    "@tailwindcss/postcss": "^4.1.12",
    "@tailwindcss/vite": "^4.1.12",
    "adm-zip": "^0.5.16",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "didyoumean2": "7.0.4",
    "dotenv": "^17.2.1",
    "electron-store": "^10.1.0",
    "electron-winston": "^1.0.0",
    "eslint": "^9.33.0",
    "express": "5.1.0",
    "glob": "11.0.3",
    "open": "10.2.0",
    "ramda": "0.31.3",
    "semver": "7.7.2",
    "super-error": "2.6.1",
    "svelte-flag-icons": "^2.0.2",
    "tailwindcss": "^4.1.12",
    "tar-fs": "3.1.0",
    "tmp": "0.2.5",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "devDependencies": {
    "@octokit/rest": "22.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.3",
    "@types/jsdom": "^21.1.7",
    "@vitest/eslint-plugin": "^1.3.4",
    "asar": "^3.2.0",
    "autoprefixer": "^10.4.21",
    "babel-plugin-istanbul": "7.0.0",
    "chai": "^6.0.1",
    "chalk": "5.5.0",
    "coveralls": "3.1.1",
    "del": "^8.0.0",
    "dmg-builder": "^26.0.12",
    "electron": "37.3.0",
    "electron-builder": "^26.0.12",
    "electron-builder-squirrel-windows": "^26.0.12",
    "electron-is-dev": "^3.0.1",
    "electron-vite": "^4.0.0",
    "globals": "^16.3.0",
    "google-translate-api-x": "^10.7.2",
    "jsdom": "^26.1.0",
    "morgan": "^1.10.1",
    "msw": "^2.10.5",
    "nock": "^14.0.10",
    "plist": "3.1.0",
    "postcss": "^8.5.6",
    "prompt": "1.3.0",
    "rcedit": "4.0.1",
    "require-dir": "1.2.0",
    "sass": "^1.90.0",
    "svelte": "^5.38.2",
    "svelte-i18n": "^4.0.1",
    "svelte-preprocess": "^6.0.3",
    "vite-plugin-node-polyfills": "^0.23.0",
    "yauzl": "3.2.0"
  }
}
