import Modals from './_modals.marko';
import { getSourceIcon } from './main_page.icons.js';

$ {
  const browseTitle = input.platform === 'darwin' 
    ? 'inputs.browse_title_macos' 
    : 'inputs.browse_title_default';
}

<i18n-var|i18n|>
  <Modals ...input/>

  <div class='main-form' id='main_view'>
    <div class='input-group'>
      <div class='input-label'>
        <i18n-message key=browseTitle/>
      </div>
      <div class='input-row'>
        <input
          id='install_path'
          type='text'
          class='text-input'
          placeholder=i18n('inputs.install_path_placeholder')>
        <button id='browse' type='button' class='pill-btn ghost'>
          <i18n-message key='browse'/>
        </button>
      </div>
      <div class='status-line'>
        <span id='input_msg'/>
      </div>
    </div>

    <div class='input-group'>
      <div class='input-label'>
        <i18n-message key='summoners_rift_source'/>
      </div>
      <div class='dropdown-shell rift_source'>
        <input id='options_sr_source' type='hidden' value=input.selected_sources>
        <button class='dropdown-trigger compact'>
          <span class='default text'>
            <i18n-message key='select_sources'/>
          </span>
          <i class='dropdown icon text-slate-300'/>
        </button>
        <div class='menu absolute top-full mt-2 w-full bg-slate-900/90 border border-white/12 rounded-lg shadow-2xl overflow-hidden hidden z-10'>
          <for|source| of=input.sources>
            <div
              data-value=source.id
              data-name=source.name
              class='item px-3 py-2 flex items-center gap-2 text-slate-200 hover:bg-sky-500/15 hover:text-white cursor-pointer transition-colors text-sm'>
              <img src=getSourceIcon(source.id) class='sourceicon w-4 h-4' alt=source.name>
              ${source.name}
            </div>
          </for>
        </div>
      </div>
    </div>

    <div class='options-grid'>
      <label class='option-row options_tooltip' data-content=i18n('options_aram_tooltip')>
        <input id='options_aram' type='checkbox'>
        <span><i18n-message key='options_aram_tooltip'/></span>
      </label>
      <label class='option-row options_tooltip' data-content=i18n('options_splititems_tooltip')>
        <input id='options_splititems' type='checkbox'>
        <span><i18n-message key='options_splititems'/></span>
      </label>
      <label class='option-row options_tooltip' data-content=i18n('options_skillsformat_tooltip')>
        <input id='options_skillsformat' type='checkbox'>
        <span>
          <i18n-message key='options_skillsformat'/>
          <span class='text-slate-400 text-xs'>
            <i18n-message key='options_skillsformat_hint'/>
          </span>
        </span>
      </label>
      <label class='option-row options_tooltip' data-content=i18n('options_consumables_tooltip')>
        <input id='options_consumables' type='checkbox' checked>
        <span><i18n-message key='options_consumables'/></span>
      </label>
      <div id='options_consumables_position' class='hidden'>
        <div class='item beginning'><i18n-message key='beginning'/></div>
        <div class='item end'><i18n-message key='end'/></div>
      </div>
      <label class='option-row options_tooltip' data-content=i18n('options_trinkets_tooltip')>
        <input id='options_trinkets' type='checkbox' checked>
        <span><i18n-message key='options_trinkets'/></span>
      </label>
      <div id='options_trinkets_position' class='hidden'>
        <div class='item beginning'><i18n-message key='beginning'/></div>
        <div class='item end'><i18n-message key='end'/></div>
      </div>
      <label class='option-row options_tooltip' data-content=i18n('options_locksr_tooltip')>
        <input id='options_locksr' type='checkbox'>
        <span><i18n-message key='options_locksr'/></span>
      </label>
      <label class='option-row options_tooltip' data-content=i18n('options_dontdeleteold_tooltip')>
        <input id='options_dontdeleteold' type='checkbox'>
        <span><i18n-message key='options_dontdeleteold'/></span>
      </label>
    </div>

    <div class='btn-row'>
      <button id='import_btn' class='primary-btn compact'>
        <i18n-message key='import'/>
      </button>
      <button id='delete_btn' class='danger-btn compact'>
        <i18n-message key='delete'/>
      </button>
    </div>

    <div class='versions-panel'>
      <div class='versions-col'>
        <div class='version-row'>
          <span><i18n-message key='versions.local_items_label'/></span>
          <span id='local_version'><i18n-message key='unknown'/></span>
        </div>
        <div class='version-row'>
          <span><i18n-message key='versions.lol_label'/></span>
          <span id='lol_version'><i18n-message key='loading'/></span>
        </div>
      </div>
      <div class='versions-col'>
        <for|source| of=input.sources>
          <div class='version-row'>
            <span>
              <i18n-message key='versions.source_label' options={ source: source.name }/>
            </span>
            <span id=source.id + '_version'><i18n-message key='loading'/></span>
          </div>
        </for>
      </div>
    </div>
  </div>

  <div class='status-page hidden' id='status_view'>
    <div class='status-header text-center mb-3'>
      <h2 class='text-lg font-semibold text-white tracking-wide'>
        <i18n-message key='status'/>
      </h2>
    </div>

    <div id='process_log' class='status-card'>
      <div
        id='itemsets_progress_bar'
        data-percent='0'
        class='status-progress rounded-full overflow-hidden relative border border-white/8 h-4'>
        <div
          style='transition-duration: 300ms; -webkit-transition-duration: 300ms;'
          class='bar bg-gradient-to-br from-lime-400 to-green-500 h-full rounded-full relative'>
          <div class='progress absolute inset-0 flex items-center justify-center text-xs text-black font-semibold'>
            0%
          </div>
        </div>
      </div>

      <div class='status-log mt-4'>
        <div class='status-log-body'>
          <div id='cl_progress'/>
        </div>
      </div>
    </div>
  </div>

  <div class='done-page hidden' id='done_view'>
    <div class='status-card center'>
      <h2 class='text-xl font-semibold text-white mb-2'>
        <i18n-message key='done'/>
      </h2>
      <div class='cat-emoji'>^.^</div>
      <div class='btn-row mt-4'>
        <button id='back_btn' class='pill-btn ghost'>
          <i18n-message key='back'/>
        </button>
        <button id='start_lol_btn' class='primary-btn compact'>
          <i18n-message key='start_league'/>
        </button>
      </div>
    </div>
  </div>
</i18n-var>