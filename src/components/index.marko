import Locales from './_locales.marko';
import MainPage from './main_page.marko';
import Background from './background.marko';
import backgroundImg from '../img/background.png?url';
import closeOsxImg from '../img/osx_buttons/close.png?url';
import minimizeOsxImg from '../img/osx_buttons/minimize.png?url';
import minimizeWinImg from '../img/win_buttons/minimize.png?url';
import maximizeWinImg from '../img/win_buttons/maximize.png?url';
import closeWinImg from '../img/win_buttons/x.png?url';
import logoImg from '../img/logo.png?url';

$ {
  const isMac = input.platform === 'darwin';
  const isWindows = input.platform === 'win32' || input.platform === 'linux';
}

<i18n-var|i18n|>
  <Background mode='image' src=backgroundImg/>

  <div class='app-shell'>
    <header class='app-chrome flex items-center justify-between px-3 py-2 border border-white/10 rounded-2xl' data-tauri-drag-region>
      <div class='flex items-center gap-2'>
        <Locales platform=input.platform locale=input.locale/>
      </div>
      <if=isMac>
        <div class='flex gap-2 shrink-0'>
          <a href='' class='sys_button close' id='titlebar-close'>
            <img src=closeOsxImg alt=i18n('window_controls.close')>
          </a>
          <a href='' class='sys_button minimize' id='titlebar-minimize'>
            <img src=minimizeOsxImg alt=i18n('window_controls.minimize')>
          </a>
          <a class='sys_button maximize' id='titlebar-maximize'/>
        </div>
      </if>
      <else-if=isWindows>
        <div class='flex gap-1 shrink-0'>
          <div
            class='sys_button minimize hover:bg-white/10 p-2 rounded transition-colors'
            id='titlebar-minimize'>
            <img src=minimizeWinImg alt=i18n('window_controls.minimize') class='w-3 h-3'>
          </div>
          <div
            class='sys_button maximize hover:bg-white/10 p-2 rounded transition-colors'
            id='titlebar-maximize'>
            <img src=maximizeWinImg alt=i18n('window_controls.maximize') class='w-3 h-3'>
          </div>
          <div
            class='sys_button close hover:bg-red-500/80 p-2 rounded transition-colors'
            id='titlebar-close'>
            <img src=closeWinImg alt=i18n('window_controls.close') class='w-3 h-3'>
          </div>
        </div>
      </else-if>
    </header>

    <div class='text-center px-3 pt-3'>
      <div class='logo-ring mx-auto mb-4'>
        <img src=logoImg alt=i18n('branding.logo_alt') class='logo-img'>
      </div>
      <div class='h-px bg-white/10 opacity-50'/>
    </div>

    <div id='view' class='app-card'>
      <MainPage ...input/>
    </div>

    <footer class='app-footer flex items-center justify-between text-sm gap-4'>
      <div class='flex items-center gap-2'>
        <a href=input.donateUrl class='text-slate-300 hover:text-white transition-colors flex items-center gap-2'>
          <i class='heart icon text-base'/>
          <i18n-message key='footer.donate'/>
        </a>
      </div>
      <div class='flex items-center gap-2'>
        <a href=input.githubUrl class='text-slate-300 hover:text-white transition-colors flex items-center gap-2'>
          <i class='github icon text-base'/>
          <i18n-message key='footer.github_name'/>
        </a>
      </div>
      <div class='championify_version text-slate-400'>
        <i18n-message key='footer.version' options={ version: input.version }/>
      </div>
    </footer>
  </div>
</i18n-var>