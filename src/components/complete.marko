<div class='w-full'>
  <div class='text-center'>
    <h3 class='text-2xl font-semibold text-white mb-6'>
      $!{input.t('done')}
    </h3>
    <img src='img/cat.gif' class='max-w-[240px] w-3/5 mx-auto mb-8'>

    <div class='flex gap-4 justify-center mb-8'>
      <button
        id='back_to_main'
        class='bg-gradient-to-br from-blue-700 to-blue-500 text-white px-6 py-2.5 rounded-full font-semibold hover:shadow-[0_10px_24px_rgba(59,130,246,0.35)] hover:-translate-y-0.5 transition-all duration-150'>
        $!{input.t('back')}
      </button>
      <button
        id='start_league'
        class='bg-gradient-to-br from-green-600 to-green-500 text-white px-6 py-2.5 rounded-full font-semibold hover:shadow-[0_10px_24px_rgba(34,197,94,0.35)] hover:-translate-y-0.5 transition-all duration-150'>
        $!{input.t('start_league')}
      </button>
    </div>

    <div class='relative text-center my-10 before:absolute before:left-0 before:top-1/2 before:w-[35%] before:h-px before:bg-white/8 after:absolute after:right-0 after:top-1/2 after:w-[35%] after:h-px after:bg-white/8'>
      <h2 class='text-lg font-semibold text-white'>
        $!{input.t('na')}
      </h2>
    </div>

    <div class='max-h-[220px] overflow-y-auto pr-2'>
      <div id='not_available_log'/>
    </div>
  </div>
</div>
