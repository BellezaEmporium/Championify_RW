import { localeOptions } from './_locales.data.js';

$ {
  let locale = input.locale || 'en';
  let menuOpen = false;

  function setLocale(newLocale) {
    locale = newLocale;
    menuOpen = false;
  }

  function toggleMenu() {
    menuOpen = !menuOpen;
  }
}

<i18n-var|i18n| locale>
  <div class='locale_selector'>
    <div id='locals_select' class='relative'>
      <input 
        type='hidden' 
        name='locale' 
        value=locale>
      <button 
        class='locale_button material-btn flex items-center gap-2 px-2 py-1 no-border'
        on-click('toggleMenu')>
        <i id='locale_flag' class=['flag-icon', 'flag-' + (localeOptions.find(o => o.value === locale)?.flag || 'gb')]/>
        <span class='sr-only'>
          <i18n-message key='select_language'/>
        </span>
        <i class='dropdown icon text-slate-400 text-xs'/>
      </button>
      <div 
        class=[
          'menu absolute top-full mt-2 bg-slate-900/95 border border-white/8 rounded-2xl shadow-2xl overflow-hidden max-h-80 overflow-y-auto',
          input.platform === 'win32' ? 'left-0' : 'right-0',
          'min-w-[200px]',
          menuOpen ? '' : 'hidden',
        ]>
        <div class='px-4 py-3 border-b border-white/8 flex items-center gap-2'>
          <i class='world icon text-sky-400'/>
          <span id='select_language_text' class='font-semibold text-white'>
            <i18n-message key='select_language'/>
          </span>
        </div>
        <for|localeOption| of=localeOptions>
          <div
            data-value=localeOption.value
            class=[
              'px-4 py-2.5 flex items-center gap-2.5 text-slate-300 hover:bg-sky-500/15 hover:text-white cursor-pointer transition-colors item',
              locale === localeOption.value ? 'active bg-sky-500/20 text-white' : '',
            ]
            on-click('setLocale', localeOption.value)>
            <i class=[localeOption.flag, 'flag']/>
            ${localeOption.label}
          </div>
        </for>
      </div>
    </div>
  </div>
</i18n-var>