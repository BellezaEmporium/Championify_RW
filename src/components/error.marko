<i18n-var|i18n|>
  <div class='w-full'>
    <div class='text-center'>
      <h3 class='text-2xl font-semibold text-red-400 mb-6'>
        <i18n-message key='something_broke'/>
      </h3>
      <img src='img/sad.png' class='max-w-[240px] w-3/5 mx-auto mb-8' alt='Error'>

      <if=typeof window !== 'undefined' && window.error_message>
        <div class='mb-6'>
          <span class='message text-red-300 bg-red-500/10 px-4 py-2 rounded-lg inline-block'>
            ${window.error_message}
          </span>
        </div>
      </if>
      <p class='text-slate-300 leading-relaxed mb-8'>
        <i18n-message key='error_1'/><br>
        <i18n-message key='error_2'/><br>
        <i18n-message key='error_3'/>
      </p>
      <button id='open_log' class='bg-gradient-to-br from-blue-700 to-blue-500 text-white px-6 py-2.5 rounded-full font-semibold hover:shadow-[0_10px_24px_rgba(59,130,246,0.35)] hover:-translate-y-0.5 transition-all duration-150'>
        <i18n-message key='open_log'/>
      </button>
    </div>
  </div>
</i18n-var>